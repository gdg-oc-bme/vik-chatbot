# VIK ChatBot: environment configuration
# Copy to `.env` and fill in the secrets. `.env` is git-ignored; never commit it.
# Every variable here maps to a field of the Settings class in src/vik_chatbot/config/.

# ---------------------------------------------------------------- app
APP_ENV=development              # development | test | production
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Google Gemini
GEMINI_API_KEY=                  # required: https://aistudio.google.com/apikey
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# gemini-embedding-001 outputs 3072 dims by default but supports 768 / 1536 / 3072.
# pgvector's HNSW index on `vector` columns is limited to 2000 dims, so we use 768.
# Changing this requires a migration and a full re-embed.
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=100
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ---------------------------------------------------------------- database
POSTGRES_USER=vik
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vik_chatbot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vik:change-me@localhost:5432/vik_chatbot
DB_POOL_SIZE=5

# ---------------------------------------------------------------- chat pipeline
HISTORY_TURNS=6                  # step 1: last N turns loaded per session
VECTOR_K=20                      # step 3: candidates from vector search
KEYWORD_K=20                     # step 3: candidates from keyword (tsvector) search
RRF_K=60                         # step 3: Reciprocal Rank Fusion constant
RERANK_ENABLED=false             # step 4: optional LLM rerank
RERANK_TOP_N=5                   # step 4: chunks kept for generation

# ---------------------------------------------------------------- API
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT=20/minute             # per client
CORS_ORIGINS=http://localhost:8501

# ---------------------------------------------------------------- UI
API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------- tracing
TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
